{
  "name": "elegance-js",
  "version": "3.1.4",
  "type": "module",
  "main": "dist/user-utils.js",
  "bin": {
    "bootstrap": "./bin/bootstrap.js",
    "elegance": "./bin/run.js",
    "elegance-export": "./bin/export.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "lint": "oxlint ./src --fix -D unused-variable -D unused-import",
    "build": "esbuild './src/*.ts' './src/**/*.ts' --outdir=./dist --outbase=./src --format=esm --platform=node --bundle=false && tsc --emitDeclarationOnly && node scripts/fix-imports.js && node scripts/copy-wasm.js",
    "test": "node --import=ts-arc/register --test \"tests/**/*.test.ts\"",
    "test:update": "UPDATE_SNAPSHOTS=1 node --import=ts-arc/register --test \"tests/**/*.test.ts\""
  },
  "exports": {
    ".": {
      "types": "./dist/user-utils.d.ts",
      "import": "./dist/user-utils.js",
      "default": "./dist/user-utils.js"
    },
    "./link": {
      "types": "./dist/components/Link.d.ts",
      "import": "./dist/components/Link.js",
      "default": "./dist/components/Link.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    },
    "./run": {
      "types": "./dist/run.d.ts",
      "import": "./dist/run.js",
      "default": "./dist/run.js"
    }
  },
  "elegance": {
    "bundle": [
      "./link"
    ],
    "no-bundle": [
      "./dist/build/*",
      "./dist/server/*",
      "./dist/processing/*",
      "./dist/image/*",
      "./dist/globals.js",
      "./dist/config.js",
      "./dist/page-tools.js",
      "./dist/constants.js",
      "./dist/error.js",
      "./dist/logger.js",
      "./dist/run.js",
      "./dist/elements.js"
    ]
  },
  "author": "vqldemar (https://github.com/valdemar-dev)",
  "keywords": [
    "elegance",
    "elegance-js",
    "css",
    "jsx",
    "tsx",
    "web-framework",
    "framework",
    "web",
    "html",
    "javascript",
    "typescript",
    "js",
    "ts",
    "web-dev",
    "web",
    "speed",
    "fast",
    "optimized"
  ],
  "license": "MIT",
  "github": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valdemar-dev/elegance-js"
  },
  "bugs": {
    "url": "https://github.com/valdemar-dev/elegance-js/issues"
  },
  "dependencies": {
    "esbuild": "^0.28.0",
    "oxc-parser": "^0.127.0",
    "ts-arc": "^1.3.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "oxlint": "^1.68.0",
    "typescript": "^5.0.0"
  }
}
